      "source": "/go/behance",
      "destination": "/?utm_source=behance&utm_medium=profile&utm_campaign=creative_producer",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dashhkuns.com"
        }
      ],
      "destination": "https://dashhkuns.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/crm-app/",
      "destination": "/crm-app/index.html"
    },
    {
      "source": "/crm-app",
      "destination": "/crm-app/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "crm.dashhkuns.com"
        }
      ],
      "destination": "/crm-app/index.html"
    },
    {
      "source": "/en/contact",
