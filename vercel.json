{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/en/contact.html",
      "destination": "/en/contact",
      "permanent": true
    },
    {
      "source": "/en/about.html",
      "destination": "/en/about",
      "permanent": true
    },
    {
      "source": "/en/projects.html",
      "destination": "/en/projects",
      "permanent": true
    },
    {
      "source": "/en/services.html",
      "destination": "/en/services",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/projects.html",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/insights.html",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/creative-producer.html",
      "destination": "/creative-producer",
      "permanent": true
    },
    {
      "source": "/project-launch.html",
      "destination": "/project-launch",
      "permanent": true
    },
    {
      "source": "/reality-show-producer.html",
      "destination": "/reality-show-producer",
      "permanent": true
    },
    {
      "source": "/creative-producer-moscow.html",
      "destination": "/creative-producer-moscow",
      "permanent": true
    },
    {
      "source": "/go/ig",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=profile",
      "permanent": false
    },
    {
      "source": "/go/tg",
      "destination": "/?utm_source=telegram&utm_medium=social&utm_campaign=profile",
      "permanent": false
    },
    {
      "source": "/go/li",
      "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=profile",
      "permanent": false
    },
    {
      "source": "/go/email",
      "destination": "/?utm_source=email&utm_medium=outreach&utm_campaign=producer_outreach",
      "permanent": false
    },
    {
      "source": "/go/internal",
      "destination": "/?internal=1",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dashhkuns.com"
        }
      ],
      "destination": "https://dashhkuns.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/crm",
      "destination": "/crm/index.html"
    },
    {
      "source": "/crm/",
      "destination": "/crm/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "crm.dashhkuns.com"
        }
      ],
      "destination": "/crm/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "crm.dashhkuns.com"
        }
      ],
      "destination": "/crm/:path*"
    },
    {
      "source": "/en/contact",
      "destination": "/en/contact.html"
    },
    {
      "source": "/en/about",
      "destination": "/en/about.html"
    },
    {
      "source": "/en/projects",
      "destination": "/en/projects.html"
    },
    {
      "source": "/en/services",
      "destination": "/en/services.html"
    },
    {
      "source": "/en/",
      "destination": "/en/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/insights",
      "destination": "/insights.html"
    },
    {
      "source": "/creative-producer",
      "destination": "/creative-producer.html"
    },
    {
      "source": "/project-launch",
      "destination": "/project-launch.html"
    },
    {
      "source": "/reality-show-producer",
      "destination": "/reality-show-producer.html"
    },
    {
      "source": "/creative-producer-moscow",
      "destination": "/creative-producer-moscow.html"
    }
  ],
  "headers": [
    {
      "source": "/crm/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://hiczdxqlmrzozdvnlqfl.supabase.co; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles-v2.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
